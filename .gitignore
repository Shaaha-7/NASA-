# Raw downloads are large: keep them local (C:\NASA_DATA), never commit them.
# Only small processed files (data/processed/) go to GitHub.
data/*
!data/processed/
!data/README.md
data/**/raw/
*.tif
*.tiff
!data/processed/**/*.tif
*.hdf
*.HDF
*.h5
*.he5
*.hdf5
*.nc
*.nc4
*.IMG
*.img
*.zip
*.tar
*.gz

# Secrets: never commit logins or tokens
.env
.netrc
_netrc
*.token

# Python / Node
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
